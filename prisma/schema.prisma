generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Схема виведена з моделей старого Java-бекенду (Master-On-Time), а не з Liquibase-чейнджлогів.
// Порядок портування: auth/users -> search -> booking -> reviews -> schedule -> решта.

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  passwordHash String
  firstName    String
  lastName     String
  phoneNumber  String?
  profileImage String?   @db.Text // зберігає data: URI (як Java @Lob)
  role         Role      @default(USER)
  dateOfBirth  DateTime?
  gender       Gender?
  visible      Boolean   @default(true) // фільтр пошуку та /api/users/specialists
  isDeleted    Boolean   @default(false) // м'яке видалення (Java @SQLDelete)
  createdAt    DateTime  @default(now())

  addressCountry String?
  addressCity    String?
  addressStreet  String?
  addressZip     String?

  googleCalendarAccessToken  String?
  googleCalendarRefreshToken String?
  calendarSyncEnabled        Boolean @default(false)

  specialistProfile   SpecialistProfile?
  bookingsAsClient    Booking[]            @relation("ClientBookings")
  reviewsWritten      Review[]             @relation("ReviewAuthor")
  availability        Availability[]
  unavailability      Unavailability[]
  categories          Category[]           @relation("CategoryOwner")
  notifications       Notification[]
  favoritesMade       Favorite[]           @relation("FavoritesByUser")
  favoritedBy         Favorite[]           @relation("FavoritedSpecialist")
  portfolioItems      PortfolioItem[]
  passwordResetTokens PasswordResetToken[]
  refreshTokens       RefreshToken[]
  savedCard           SavedCard?

  @@map("users")
}

model SpecialistProfile {
  id         Int       @id @default(autoincrement())
  user       User      @relation(fields: [userId], references: [id])
  userId     Int       @unique
  profession String    @default("")
  about      String    @default("")
  price      Decimal   @default(0) @db.Decimal(10, 2)
  tags       String[]
  experience Int       @default(0)
  rating     Float     @default(0)
  // Одна з 5 фіксованих "вітринних" індустрій для навігації по /people —
  // окремо від Category/CategoryItem (це конкретні бронювані послуги, які
  // спеціаліст називає довільно). null, доки спеціаліст її не обрав.
  industry   Industry?

  bookingsAsSpecialist Booking[] @relation("SpecialistBookings")
  reviewsReceived      Review[]  @relation("ReviewTarget")

  @@map("specialist_profiles")
}

model Booking {
  id                Int               @id @default(autoincrement())
  client            User?             @relation("ClientBookings", fields: [clientId], references: [id])
  clientId          Int? // null для BLOCKED-слотів
  specialist        SpecialistProfile @relation("SpecialistBookings", fields: [specialistId], references: [id])
  specialistId      Int
  serviceItem       CategoryItem?     @relation(fields: [serviceItemId], references: [id])
  serviceItemId     Int?
  startTime         DateTime
  endTime           DateTime
  status            BookingStatus     @default(CONFIRMED)
  proposedStartTime DateTime?
  proposedEndTime   DateTime?
  rescheduleMessage String?
  reason            String? // причина блокування слоту
  followUpSent      Boolean           @default(false)
  priceAtBooking    Decimal           @db.Decimal(10, 2)
  createdAt         DateTime          @default(now())

  review Review?

  @@map("bookings")
}

model Review {
  id           Int               @id @default(autoincrement())
  booking      Booking           @relation(fields: [bookingId], references: [id])
  bookingId    Int               @unique
  author       User              @relation("ReviewAuthor", fields: [authorId], references: [id]) // = clientId у DTO-відповідях
  authorId     Int
  specialist   SpecialistProfile @relation("ReviewTarget", fields: [specialistId], references: [id])
  specialistId Int
  rating       Int
  comment      String?
  status       ReviewStatus      @default(VISIBLE)
  createdAt    DateTime          @default(now())

  @@map("reviews")
}

model Category {
  id           Int            @id @default(autoincrement())
  name         String
  specialist   User           @relation("CategoryOwner", fields: [specialistId], references: [id])
  specialistId Int
  items        CategoryItem[]

  @@map("categories")
}

model CategoryItem {
  id              Int       @id @default(autoincrement())
  name            String
  durationMinutes Int
  price           Float
  category        Category  @relation(fields: [categoryId], references: [id])
  categoryId      Int
  bookings        Booking[]

  @@map("category_items")
}

model Availability {
  id           Int       @id @default(autoincrement())
  dayOfWeek    DayOfWeek
  startTime    String // "09:00" (LocalTime)
  endTime      String
  specialist   User      @relation(fields: [specialistId], references: [id])
  specialistId Int

  @@map("availabilities")
}

model Unavailability {
  id           Int      @id @default(autoincrement())
  startTime    DateTime
  endTime      DateTime
  specialist   User     @relation(fields: [specialistId], references: [id])
  specialistId Int

  @@map("unavailabilities")
}

// In-app сповіщення — заміна email, поки немає реального SMTP/сервісу
// (див. lib/notifications.ts). bookingId — довідково для deep-link на
// фронті, без FK (бронювання не видаляються фізично, але не варто
// ускладнювати схему заради поля, яке лише підказує посилання).
model Notification {
  id        Int              @id @default(autoincrement())
  user      User             @relation(fields: [userId], references: [id])
  userId    Int
  type      NotificationType
  title     String
  body      String
  read      Boolean          @default(false)
  bookingId Int?
  createdAt DateTime         @default(now())

  @@index([userId, read])
  @@map("notifications")
}

enum NotificationType {
  BOOKING_CREATED
  BOOKING_CANCELLED
  RESCHEDULE_PROPOSED
  RESCHEDULE_ACCEPTED
  RESCHEDULE_DECLINED
  REVIEW_RECEIVED
}

// Токен для "Forgot password" — зберігаємо лише SHA-256 хеш (не сирий
// токен), як паролі. Сирий токен іде "поштою" — поки немає SMTP, це лог на
// сервері (той самий підхід, що й lib/notifications.ts).
model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  user      User      @relation(fields: [userId], references: [id])
  userId    Int
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("password_reset_tokens")
}

// Refresh-токени — так JWT-сесію можна реально відкликати (logout, зміна
// пароля), а не лише "забути" на клієнті. Той самий підхід, що й
// PasswordResetToken: зберігаємо тільки SHA-256 хеш, ніколи сирий токен.
// Ротація при кожному /auth/refresh: старий revoked, видається новий.
model RefreshToken {
  id        Int       @id @default(autoincrement())
  user      User      @relation(fields: [userId], references: [id])
  userId    Int
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// Збережена картка (LiqPay card_token) — "Лише зберегти картку": юзер додає
// картку раз на /profile, гроші при цьому НЕ списуються (див. lib/liqpay.ts:
// це двостадійний action:"hold" без наступного hold_completion — тимчасове
// блокування суми на картці, як застава, а не реальний переказ продавцю).
// Сам номер картки ми ніколи не бачимо й не зберігаємо — лише токен від
// LiqPay і маску для показу в UI. Один юзер — одна картка (@unique), як і
// в оригінальному сценарії "замінити декоративну картку на /profile".
model SavedCard {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id])
  userId    Int      @unique
  cardToken String
  cardMask  String
  cardType  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("saved_cards")
}

// Обране: юзер зберігає собі список спеціалістів.
model Favorite {
  id               Int      @id @default(autoincrement())
  user             User     @relation("FavoritesByUser", fields: [userId], references: [id])
  userId           Int
  specialist       User     @relation("FavoritedSpecialist", fields: [specialistUserId], references: [id])
  specialistUserId Int
  createdAt        DateTime @default(now())

  @@unique([userId, specialistUserId])
  @@map("favorites")
}

// Портфоліо спеціаліста — фото + підпис, той самий підхід до зображень, що
// й User.profileImage (data: URI, без файлового сховища).
model PortfolioItem {
  id               Int      @id @default(autoincrement())
  specialist       User     @relation(fields: [specialistUserId], references: [id])
  specialistUserId Int
  imageUrl         String   @db.Text
  caption          String   @default("")
  createdAt        DateTime @default(now())

  @@map("portfolio_items")
}

enum Role {
  USER
  SPECIALIST
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  BLOCKED
  RESCHEDULE_REQUESTED
}

enum ReviewStatus {
  VISIBLE
  FLAGGED
  EDITED
  HIDDEN
  DELETED
}

// 5 фіксованих "вітринних" категорій показаних на /services та /people —
// навмисно окремо від Category/CategoryItem (див. SpecialistProfile.industry).
enum Industry {
  HOME_GARDEN
  HEALTH_WELLBEING
  WEDDINGS_EVENTS
  BUSINESS_SERVICES
  LESSONS_TRAINING
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}
