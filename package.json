{
  "name": "masterontime-backend",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "status": "node scripts/status.js",
    "smoke": "node scripts/smoke.js && node scripts/smoke-search.js && node scripts/smoke-booking.js && node scripts/smoke-reviews.js && node scripts/smoke-schedule.js && node scripts/smoke-admin.js && node scripts/smoke-specialist-profile.js && node scripts/smoke-categories.js && node scripts/smoke-notifications.js && node scripts/smoke-favorites.js && node scripts/smoke-portfolio.js && node scripts/smoke-password-reset.js && node scripts/smoke-proxy.js",
    "seed:admin": "node scripts/seed-admin.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "eslint": "^9.17.0",
    "prisma": "^6.1.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.2"
  }
}
